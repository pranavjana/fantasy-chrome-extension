{
  "manifest_version": 3,
  "name": "TinyFish Fantasy World Cup Companion",
  "description": "Fantasy football copilot for researching players and managing your FIFA World Cup Fantasy team powered by TinyFish.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TinyFish Fantasy World Cup Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://play.fifa.com/fantasy/team*"],
      "js": ["src/content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://openrouter.ai/api/v1/*",
    "https://api.openai.com/v1/*",
    "https://api.anthropic.com/v1/*",
    "https://api.search.tinyfish.ai/*",
    "https://api.fetch.tinyfish.ai/*",
    "https://play.fifa.com/fantasy/team*",
    "https://play.fifa.com/json/fantasy/*"
  ],
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "tabs"]
}
